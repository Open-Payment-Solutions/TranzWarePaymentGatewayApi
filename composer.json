{
  "name": "open-payment-solutions/tranzware-payment-gateway",
  "description": "Library for working with TranzWare Payment Gateway",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Anar K. Jafarov",
      "email": "anar.k.jafarov@gmail.com",
      "homepage": "http://anarjafarov.me",
      "role": "Maintainer"
    },
    {
      "name": "Eugene Buchinsky",
      "email": "jonston@list.ru",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*"
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "test:coverage": "./vendor/bin/phpunit --coverage-text",
    "lint": "./vendor/bin/phpcs",
    "format": "./vendor/bin/phpcbf"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.58",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "OpenPaymentSolutions\\TranzWarePaymentGateway\\": "src/",
      "OpenPaymentSolutions\\TranzWarePaymentGateway\\Requests\\": "src/requests/",
      "OpenPaymentSolutions\\TranzWarePaymentGateway\\Handlers\\": "src/handlers/",
      "tests\\": "tests/",
      "OpenPaymentSolutions\\TranzWarePaymentGateway\\Exceptions\\": "src/exceptions/",
      "OpenPaymentSolutions\\TranzWarePaymentGateway\\Data\\": "src/data/"
    }
  }
}
